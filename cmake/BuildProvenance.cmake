execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_VARIABLE CH_BUILD_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git diff --quiet HEAD -- WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" RESULT_VARIABLE CH_BUILD_DIRTY)
execute_process(COMMAND git rev-parse --absolute-git-dir WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_VARIABLE CH_GIT_DIR OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND git symbolic-ref -q HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_VARIABLE CH_GIT_REF OUTPUT_STRIP_TRAILING_WHITESPACE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CH_GIT_DIR}/HEAD")
if(CH_GIT_REF)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CH_GIT_DIR}/${CH_GIT_REF}")
endif()
set(provenance "{}")
string(JSON provenance SET "${provenance}" schema 1)
string(JSON provenance SET "${provenance}" version "\"${PROJECT_VERSION}\"")
string(JSON provenance SET "${provenance}" commit "\"${CH_BUILD_COMMIT}\"")
if(CH_BUILD_DIRTY EQUAL 0)
  string(JSON provenance SET "${provenance}" dirty false)
else()
  string(JSON provenance SET "${provenance}" dirty true)
endif()
if(APPLE)
  set(native_platform macOS)
  set(architectures "${CMAKE_OSX_ARCHITECTURES}")
  if(NOT architectures)
    set(architectures "${CMAKE_SYSTEM_PROCESSOR}")
  endif()
else()
  set(native_platform "${CMAKE_SYSTEM_NAME}")
  set(architectures "${CMAKE_SYSTEM_PROCESSOR}")
endif()
set(arch_json "[]")
set(i 0)
foreach(arch IN LISTS architectures)
  if(arch MATCHES "^(AMD64|amd64)$")
    set(arch x86_64)
  endif()
  string(JSON arch_json SET "${arch_json}" ${i} "\"${arch}\"")
  math(EXPR i "${i}+1")
endforeach()
string(JSON provenance SET "${provenance}" platform "\"${native_platform}\"")
string(JSON provenance SET "${provenance}" architectures "${arch_json}")
string(JSON provenance SET "${provenance}" configuration "\"$<CONFIG>\"")
set(formats "${CH_JUCE_FORMATS}")
if(CH_BUILD_CLAP)
  list(APPEND formats CLAP)
endif()
set(formats_json "[]")
set(i 0)
foreach(format IN LISTS formats)
  string(JSON formats_json SET "${formats_json}" ${i} "\"${format}\"")
  math(EXPR i "${i}+1")
endforeach()
string(JSON provenance SET "${provenance}" formats "${formats_json}")
set(licenses "{}")
macro(ch_license name path)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing license for ${name}: ${path}")
  endif()
  file(TO_CMAKE_PATH "${path}" license_path)
  string(JSON licenses SET "${licenses}" "${name}" "\"${license_path}\"")
endmacro()
ch_license(CONVOLUTION-HOST "${PROJECT_SOURCE_DIR}/LICENSE")
ch_license(JUCE "${juce_SOURCE_DIR}/LICENSE.md")
ch_license(AGPL-3.0 "${PROJECT_SOURCE_DIR}/licenses/AGPL-3.0.txt")
ch_license(Dependency-notices "${PROJECT_SOURCE_DIR}/docs/dependency-licenses.md")
ch_license(JUCE-FLAC "${juce_SOURCE_DIR}/modules/juce_audio_formats/codecs/flac/Flac Licence.txt")
ch_license(JUCE-OggVorbis "${juce_SOURCE_DIR}/modules/juce_audio_formats/codecs/oggvorbis/Ogg Vorbis Licence.txt")
ch_license(JUCE-JPEG "${juce_SOURCE_DIR}/modules/juce_graphics/image_formats/jpglib/README")
ch_license(JUCE-PNG "${juce_SOURCE_DIR}/modules/juce_graphics/image_formats/pnglib/LICENSE")
ch_license(JUCE-zlib "${juce_SOURCE_DIR}/modules/juce_core/zip/zlib/README")
ch_license(JUCE-HarfBuzz "${juce_SOURCE_DIR}/modules/juce_graphics/fonts/harfbuzz/COPYING")
ch_license(JUCE-SheenBidi "${juce_SOURCE_DIR}/modules/juce_graphics/unicode/sheenbidi/LICENSE")
foreach(lv2lib lilv lv2 serd sord sratom)
  ch_license(JUCE-LV2-${lv2lib} "${juce_SOURCE_DIR}/modules/juce_audio_processors/format_types/LV2_SDK/${lv2lib}/COPYING")
endforeach()
ch_license(VST3-SDK "${juce_SOURCE_DIR}/modules/juce_audio_processors/format_types/VST3_SDK/LICENSE.txt")
if(NOT APPLE)
  ch_license(FFTW "${fftw_SOURCE_DIR}/COPYING")
  ch_license(FFTW-RT-adaptation "${PROJECT_SOURCE_DIR}/docs/fftw-realtime.md")
endif()
if(CH_BUILD_CLAP)
  ch_license(CLAP-bus-adaptation "${PROJECT_SOURCE_DIR}/docs/clap-bus-adaptation.md")
  ch_license(CLAP-wrapper "${clap_extensions_SOURCE_DIR}/LICENSE.md")
  ch_license(CLAP "${clap_extensions_SOURCE_DIR}/clap-libs/clap/LICENSE")
  ch_license(CLAP-helpers "${clap_extensions_SOURCE_DIR}/clap-libs/clap-helpers/LICENSE")
endif()
if(CH_BUILD_AAX)
  if(CH_AAX_SDK_PATH)
    set(aax_licenses "${CH_AAX_SDK_PATH}")
  else()
    set(aax_licenses "${juce_SOURCE_DIR}/modules/juce_audio_plugin_client/AAX/SDK")
  endif()
  ch_license(AAX-SDK "${aax_licenses}/LICENSE.txt")
endif()
if(CH_BUILD_AU)
  ch_license(AU-SDK "${juce_SOURCE_DIR}/modules/juce_audio_plugin_client/AU/AudioUnitSDK/LICENSE.txt")
endif()
string(JSON provenance SET "${provenance}" licenses "${licenses}")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/build-provenance-$<CONFIG>.json" CONTENT "${provenance}\n")
