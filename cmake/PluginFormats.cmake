option(CH_BUILD_PLUGIN "Build native plugin wrappers and standalone" ON)
set(CH_APPLE_DEFAULT OFF)
set(CH_AAX_DEFAULT OFF)
if(APPLE)
  set(CH_APPLE_DEFAULT ON)
endif()
if(APPLE OR WIN32)
  set(CH_AAX_DEFAULT ON)
endif()
option(CH_BUILD_VST3 "Build VST3" ON)
option(CH_BUILD_STANDALONE "Build native standalone" ON)
option(CH_BUILD_CLAP "Build CLAP" ON)
option(CH_BUILD_AU "Build Audio Unit on macOS" ${CH_APPLE_DEFAULT})
option(CH_BUILD_AAX "Build AAX on Windows/macOS" ${CH_AAX_DEFAULT})
set(CH_AAX_SDK_PATH "" CACHE PATH "Optional external AAX SDK; otherwise use JUCE bundled SDK")
set(CH_JUCE_FORMATS "")
if(CH_BUILD_PLUGIN)
  if(CH_BUILD_AU AND NOT APPLE)
    message(FATAL_ERROR "AU requires a native macOS build")
  endif()
  if(CH_BUILD_AAX AND NOT (APPLE OR WIN32))
    message(FATAL_ERROR "AAX requires a native Windows or macOS build")
  endif()
  if(CH_BUILD_AAX AND CH_AAX_SDK_PATH)
    if(NOT EXISTS "${CH_AAX_SDK_PATH}/Interfaces/ACF" OR NOT EXISTS "${CH_AAX_SDK_PATH}/Libs/AAXLibrary")
      message(FATAL_ERROR "AAX SDK is incomplete: ${CH_AAX_SDK_PATH}")
    endif()
  endif()
  foreach(format VST3 Standalone AU AAX)
    string(TOUPPER "${format}" option_name)
    if(CH_BUILD_${option_name})
      list(APPEND CH_JUCE_FORMATS ${format})
    endif()
  endforeach()
endif()
