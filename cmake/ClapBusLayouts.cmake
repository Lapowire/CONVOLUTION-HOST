# The pinned wrapper exposes only its default stereo ports. Adapt a generated
# copy, preserving the verified dependency checkout and all upstream notices.
set(wrapper_source "${clap_extensions_SOURCE_DIR}/src/wrapper/clap-juce-wrapper.cpp")
file(READ "${wrapper_source}" wrapper)
set(start_token "    bool audioPortsInfo(")
set(end_token "    bool implementsNotePorts()")
string(FIND "${wrapper}" "${start_token}" start)
string(FIND "${wrapper}" "${end_token}" end)
if(start LESS 0 OR end LESS start)
  message(FATAL_ERROR "Pinned CLAP wrapper changed; review bus adapter anchors")
endif()
string(SUBSTRING "${wrapper}" 0 ${start} prefix)
string(SUBSTRING "${wrapper}" ${end} -1 suffix)
set(wrapper "${prefix}#include \"plugin/ClapBusMethods.inc\"\n${suffix}")
set(include_anchor "#include <clap-juce-extensions/clap-juce-extensions.h>")
string(FIND "${wrapper}" "${include_anchor}" include_position)
if(include_position LESS 0)
  message(FATAL_ERROR "Pinned CLAP include changed; review bus adapter")
endif()
string(REPLACE "${include_anchor}" "${include_anchor}\n#include \"plugin/ClapBusSupport.h\"" wrapper "${wrapper}")
set(adapted_dir "${CMAKE_CURRENT_BINARY_DIR}/ch-clap-wrapper")
file(MAKE_DIRECTORY "${adapted_dir}")
file(CONFIGURE OUTPUT "${adapted_dir}/clap-juce-wrapper.cpp" CONTENT "@wrapper@" @ONLY)
if(APPLE)
  configure_file("${clap_extensions_SOURCE_DIR}/src/wrapper/clap-juce-mac.mm" "${adapted_dir}/clap-juce-mac.mm" COPYONLY)
  set_property(TARGET clap_juce_sources PROPERTY INTERFACE_SOURCES "${adapted_dir}/clap-juce-mac.mm")
else()
  set_property(TARGET clap_juce_sources PROPERTY INTERFACE_SOURCES "${adapted_dir}/clap-juce-wrapper.cpp")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${wrapper_source}")
