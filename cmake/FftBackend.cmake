set(default_fft bundled)
set(CH_FFTW_PROVIDER "${default_fft}" CACHE STRING "FFTW provider: system or bundled")
set_property(CACHE CH_FFTW_PROVIDER PROPERTY STRINGS system bundled)
if(NOT CH_FFTW_PROVIDER MATCHES "^(system|bundled)$")
  message(FATAL_ERROR "Unknown FFTW provider: ${CH_FFTW_PROVIDER}")
endif()
add_library(ch_fft_backend INTERFACE)
if(NOT APPLE)
  if(CH_FFTW_PROVIDER STREQUAL "bundled")
    include(FetchContent)
    set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
    set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(ENABLE_FLOAT ON CACHE BOOL "" FORCE)
    set(ENABLE_THREADS OFF CACHE BOOL "" FORCE)
    set(ENABLE_OPENMP OFF CACHE BOOL "" FORCE)
    set(DISABLE_FORTRAN ON CACHE BOOL "" FORCE)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
      set(ENABLE_SSE2 ON CACHE BOOL "" FORCE)
    endif()
    FetchContent_Declare(fftw
      URL https://deb.debian.org/debian/pool/main/f/fftw3/fftw3_3.3.10.orig.tar.gz
      URL_HASH SHA256=56c932549852cddcfafdab3820b0200c7742675be92179e59e6215b340e26467)
    FetchContent_MakeAvailable(fftw)
    # JUCE's FFTW adapter requests ESTIMATE plans without NO_BUFFERING. FFTW's
    # rdft2-buffered solver mallocs during execute, which is unsafe for audio.
    # Build a narrowly amended copy of mapflags.c; never edit the pinned sources.
    file(READ "${fftw_SOURCE_DIR}/api/mapflags.c" mapflags)
    set(flag_anchor "unsigned l, u, t;")
    string(FIND "${mapflags}" "${flag_anchor}" flag_position)
    if(flag_position EQUAL -1)
      message(FATAL_ERROR "FFTW planner source changed; review no-buffering adaptation")
    endif()
    string(REPLACE "${flag_anchor}" "${flag_anchor}\n     flags |= FFTW_NO_BUFFERING; /* CONVOLUTION HOST realtime requirement */" mapflags "${mapflags}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/ch-fftw-mapflags.c" "${mapflags}")
    get_target_property(fftw_sources fftw3f SOURCES)
    list(FILTER fftw_sources EXCLUDE REGEX "/api/mapflags[.]c$")
    set_property(TARGET fftw3f PROPERTY SOURCES "${fftw_sources};${CMAKE_CURRENT_BINARY_DIR}/ch-fftw-mapflags.c")
    set_target_properties(fftw3f PROPERTIES C_VISIBILITY_PRESET hidden)
    target_link_libraries(ch_fft_backend INTERFACE fftw3f)
    target_include_directories(ch_fft_backend INTERFACE "${fftw_SOURCE_DIR}/api")
  else()
    message(FATAL_ERROR "System FFTW provider cannot enforce allocation-free plans with JUCE; use CH_FFTW_PROVIDER=bundled")
  endif()
  target_compile_definitions(ch_fft_backend INTERFACE JUCE_DSP_USE_STATIC_FFTW=1)
endif()
